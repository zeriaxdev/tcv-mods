extends SceneTree
func _initialize(): call_deferred("check_ui")
func check_ui():
 var shell = load("res://scene/menu/_master/menu_master.tscn").instantiate()
 shell.stopgap_ignore_standard_instruction = true
 root.add_child(shell)
 shell.NewSlide("res://net/community_pack_browser.tscn", false)
 await process_frame
 var browser = shell.get_node("SlideCapsule").get_child(0)
 browser._catalog.cancel()
 assert(browser.get_script().get_base_script().get_global_name() == "MenuBase")
 assert(browser._list is Tree)
 assert(browser._install_button.has_method("GradHover"))
 assert(shell.btn_back.visible)
 assert(not shell.btn_discard_return.visible)
 assert(shell.slide_hint_path.lbl.text.contains("Community Packs"))
 assert(not browser._detail_content.visible)
 assert(browser._install_status.text == "")
 assert(browser._rated.get_theme_color("font_hover_pressed_color") == Color.BLACK)
 assert(browser._uninstall_dialog.theme.get_color("font_color", "Label") == Color.BLACK)
 browser._selected = {"id":42, "name":"Test pack"}
 browser._on_detail_loaded({"id":42,"name":"Test pack","author":"Test","files":[]})
 assert(browser._install_button.disabled)
 assert(browser._install_status.text == "This submission has no downloadable files.")
 browser._show_installed()
 assert(browser._view_mode == "installed")
 assert(not browser._search_tools.visible)
 assert(browser.get_node_or_null("InstalledModal") == null)
 browser._show_installed_detail({"mod_id":42,"name":"Test installed pack","author":"Test","installed_bytes":200,"folder":"Test","profile_url":"https://gamebanana.com/mods/42"})
 assert(browser._uninstall_button.visible)
 assert(not browser._install_button.visible)
 assert(browser._detail_title.text == "Test installed pack")
 browser._show_downloads()
 assert(browser._view_mode == "downloads")
 assert(browser._online_downloads_box.visible)
 browser._show_download_detail({"id":"test-job","mod":{"name":"Test download"},"file":{"name":"test.zip"},"state":"failed","error":"Test error"})
 assert(browser._mode_actions.get_child_count() == 2)
 browser._show_browse()
 browser._catalog.cancel()
 assert(browser._view_mode == "browse")
 assert(browser._search_tools.visible)
 shell.NewSlide("res://net/lobby.tscn", false)
 await process_frame
 var lobby = shell.get_node("SlideCapsule").get_child(0)
 assert(lobby.get_script().get_base_script().get_global_name() == "MenuBase")
 assert(lobby.host_button.has_method("GradHover"))
 assert(shell.slide_hint_path.lbl.text.contains("Online"))
 shell.new_slide_from_data()
 await process_frame
 assert(shell.get_node("SlideCapsule").get_child(0).scene_file_path.ends_with("menu_home.tscn"))
 print("Native menu shell, Tree, ButtonCV, contrast and return checks passed")
 shell.queue_free()
 quit()
