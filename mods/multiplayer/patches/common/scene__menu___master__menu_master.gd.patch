--- a/scene/menu/_master/menu_master.gd
+++ b/scene/menu/_master/menu_master.gd
@@ -45,6 +45,10 @@
 	if assume_path: path = "res://scene/menu/" + path + ".tscn"
 	if slide_capsule: for el: Node in slide_capsule.get_children(): el.queue_free()
 	var current_slide: Control = load(path).instantiate()
+	# every copy of a slide shares one menu_data, and the hint loop below writes
+	# over its "&" markers, so the first visit fixed the breadcrumb for the
+	# whole session (Solo stuck after going Group). work on a copy.
+	current_slide.menu_data = current_slide.menu_data.duplicate()
 	match current_slide.menu_data.type:
 		MenuData.SLIDETYPE.NORMAL:
